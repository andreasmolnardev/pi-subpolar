# PocketBase connection used by the Bun bridge.
# Start a PocketBase server separately, or point these at the same instance used by Subpolar.
POCKETBASE_URL=http://127.0.0.1:8090
POCKETBASE_EMAIL=admin@example.com
POCKETBASE_PASSWORD=change-me

# Optional first-user bootstrap. If both are set, public registration is disabled.
ADMIN_EMAIL=
ADMIN_PASSWORD=
AUTH_REGISTRATION_ENABLED=true
AUTH_SECURE_COOKIES=false

# Used only for bridge-to-Pi tool authorization requests. A random value is generated
# for local development when omitted; set a stable value for multiple bridge workers.
SUBPOLAR_INTERNAL_TOKEN=

WEBUI_PORT=4173
