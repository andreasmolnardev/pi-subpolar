{
  "name": "@subpolar/subpolar-agent",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun run --bun vite",
    "bridge": "bun bridge.ts",
    "build": "bun run --bun tsc -b && bun run --bun vite build",
    "typecheck": "bun run --bun tsc --noEmit -p tsconfig.app.json",
    "bridge:typecheck": "bun run --bun tsc --noEmit -p tsconfig.bridge.json",
    "test:ui": "bun x --no-install vitest run src --maxWorkers=4",
    "test:server": "bun scripts/test-server.ts",
    "test:voice": "bun x --no-install vitest run --config server/voice/vitest.config.ts",
    "lint": "bun run --bun eslint src/App.tsx src/pi.ts",
    "preview": "bun run --bun vite preview"
  },
  "dependencies": {
    "@subpolar/client": "workspace:*",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@earendil-works/pi-ai": "1.0.2",
    "@earendil-works/pi-coding-agent": "1.0.2",
    "@earendil-works/pi-tui": "1.0.2",
    "@hookform/resolvers": "^5.2.2",
    "@radix-ui/react-checkbox": "^1.3.3",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-label": "^2.1.7",
    "@radix-ui/react-popover": "^1.1.17",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-slider": "^1.3.6",
    "@radix-ui/react-slot": "^1.2.3",
    "@radix-ui/react-switch": "^1.2.6",
    "@radix-ui/react-tabs": "^1.1.13",
    "@radix-ui/react-tooltip": "^1.2.16",
    "@tailwindcss/vite": "^4.1.14",
    "@tanstack/react-query": "^5.90.5",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cronstrue": "^3.13.0",
    "date-fns": "^4.1.0",
    "diff": "^8.0.2",
    "highlight.js": "^11.11.1",
    "hono": "^4.9.7",
    "lucide-react": "^0.546.0",
    "mermaid": "^11.12.2",
    "pocketbase": "^0.23.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-hook-form": "^7.65.0",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.13.0",
    "rehype-highlight": "^7.0.2",
    "rehype-raw": "^7.0.0",
    "remark-gfm": "^4.0.1",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.3.1",
    "typebox": "^1.3.7",
    "yaml": "^2.9.0",
    "zod": "^4.1.12",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@eslint/js": "^9.36.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.1",
    "@testing-library/user-event": "^14.6.1",
    "@types/bun": "^1.4.2",
    "@types/node": "^24.8.1",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "@vitejs/plugin-react": "^5.0.4",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.22",
    "globals": "^16.4.0",
    "jsdom": "^27.4.0",
    "openapi-typescript": "^7.10.1",
    "postcss": "^8.5.6",
    "tailwindcss": "^4.1.14",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.45.0",
    "vite": "^7.1.7",
    "vitest": "^3.2.4"
  }
}
