{
  "name": "pi-subpolar",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "./start-webui.sh",
    "start": "./start-webui.sh",
    "webui": "npm --prefix @webui run dev",
    "bridge": "bun @webui/bridge.ts",
    "tools:cli": "bun packages/subpolar-tools/src/cli.ts",
    "typecheck": "npm --prefix @webui run typecheck",
    "build": "npm --prefix @webui run build",
    "test:core": "bun test packages/subpolar-contracts packages/subpolar-core packages/subpolar-persistance-local packages/subpolar-persistance-pocketbase packages/subpolar-core-pi packages/subpolar-tools packages/subpolar-cli",
    "test:e2e:contract": "bun test e2e/contract-smoke.test.ts",
    "test:e2e:live": "E2E_LIVE=true bun test e2e/live-smoke.test.ts"
  }
}
