{
  "name": "pi-subpolar",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "./start-webui.sh",
    "start": "./start-webui.sh",
    "webui": "npm --prefix @webui run dev",
    "bridge": "bun @webui/bridge.ts",
    "tools:cli": "bun packages/subpolar-tools-cli/src/cli.ts",
    "typecheck": "npm --prefix @webui run typecheck",
    "build": "npm --prefix @webui run build",
    "test:core": "bun test packages/subpolar-contracts packages/subpolar-core packages/subpolar-adapter-local packages/subpolar-adapter-pocketbase packages/subpolar-cli"
  }
}
