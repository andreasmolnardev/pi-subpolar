{
  "name": "pi-subpolar",
  "private": true,
  "packageManager": "bun@1.3.14",
  "engines": { "bun": ">=1.3.14" },
  "workspaces": [
    "@subpolar-agent",
    "packages/*"
  ],
  "scripts": {
    "dev": "./start-subpolar-agent.sh",
    "start": "./start-subpolar-agent.sh",
    "subpolar-agent": "bun run --cwd @subpolar-agent dev",
    "bridge": "bun @subpolar-agent/bridge.ts",
    "tools:cli": "bun packages/subpolar-tools/src/cli.ts",
    "typecheck": "bun run --cwd @subpolar-agent typecheck && bun run --cwd @subpolar-agent bridge:typecheck",
    "build": "bun run --cwd @subpolar-agent build",
        "test:ui": "bun run --cwd @subpolar-agent test:ui",
        "test:server": "bun run --cwd @subpolar-agent test:server",
        "test:voice": "bun run --cwd @subpolar-agent test:voice",
    "test:core": "bun test packages/subpolar-contracts packages/subpolar-core packages/subpolar-persistance-local packages/subpolar-persistance-pocketbase packages/subpolar-core-pi packages/subpolar-tools packages/subpolar-cli",
    "test:e2e:contract": "bun test e2e/contract-smoke.test.ts",
    "test:e2e:live": "E2E_LIVE=true bun test e2e/live-smoke.test.ts"
  }
}
